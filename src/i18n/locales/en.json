  "change-log": {
    "header": {
      "title": "Changelog",
      "subtitle": "Version {value}"
    },
    "content": {
      "note1": {
        "type": "Improvement",
        "tagType": "info",
        "note": "Task list: filters are now saved in memory when changing pages."
      },
      "note2": {
        "type": "Improvement",
        "tagType": "info",
        "note": "Task card: Entering or pasting an external link now transforms the text into a clickable link."
      },
      "note3": {
        "type": "New",
        "tagType": "success",
        "note": "The changelog page is now public. It's accessible via the version number in the settings panel."
      },
      "note4": {
        "type": "New",
        "tagType": "success",
        "note": "Task card: it's now possible to view information for a completed task."
      },
      "note5": {
        "type": "New",
        "tagType": "success",
        "note": "Task card: it's now possible to mark a task as priority via the red flag icon."
      },
      "note6": {
        "type": "New",
        "tagType": "success",
        "note": "Task list: importing and exporting the task list is now possible from the settings panel. This process takes into account the tags associated with the tasks."
      },
      "note7": {
        "type": "Fix",
        "tagType": "warn",
        "note": "Tags list: fixed the edit menu that was not responsive to language changes."
      },
      "note8": {
        "type": "Improvement",
        "tagType": "info",
        "note": "Task card: A confirmation is requested when attempting to delete an uncompleted task."
      },
      "note9": {
        "type": "New",
        "tagType": "success",
        "note": "Settings: It is now possible to display the technical ID of tasks. The choice is between the default \"native\" technical ID generated when the task is created (whose prefix can be modified), or a unique \"generated\" ID built from numbers and letters. In the task list, clicking on the ID copies it."
      }
    }
  }
